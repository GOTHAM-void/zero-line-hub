rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function isActiveStaff() {
      return request.auth != null && staffDoc().active == true;
    }
    function hasRole(role) {
      return isActiveStaff() && staffDoc().role == role;
    }

    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || hasRole('admin'));
      allow write: if hasRole('admin');
    }

    match /patients/{patientId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if hasRole('admin');
    }

    match /tokens/{tokenId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if hasRole('admin');
    }

    // Zero-leak public projection for ?track=T-XXX (single-doc get only; no collection enumeration)
    match /public_tokens/{tokenStr} {
      allow get: if true;
      allow list: if isActiveStaff();
      allow write: if isActiveStaff();
    }

    // Immutable prescriptions: doctors create only for their own UID; no tampering
    match /prescriptions/{rxId} {
      allow read: if isActiveStaff();
      allow create: if hasRole('doctor') && request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Hardened: admins/pharmacists manage stock; doctors decrement integers only with server timestamp
    match /medicines/{medId} {
      allow read: if isActiveStaff();
      allow create, delete: if hasRole('admin');
      allow update: if hasRole('admin') || hasRole('pharmacist') || (
        hasRole('doctor') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock &&
        request.resource.data.updatedAt == request.time
      );
    }

    // ISO 27789:2013 aligned immutable audit trail (strictly append-only, verified actor & server time)
    match /audit_logs/{logId} {
      allow create: if isActiveStaff() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.timestamp == request.time;
      allow read: if hasRole('admin');
      allow update, delete: if false;
    }

    // India DPDP Act 2023 verifiable consent receipts (append-only; withdrawals logged as new events)
    match /consent_records/{consentId} {
      allow read, create: if isActiveStaff();
      allow update, delete: if false;
    }
  }
}
